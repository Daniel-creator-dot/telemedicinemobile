PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/digihealth
JWT_SECRET=change-me
NODE_ENV=development
# Optional Firebase Admin JSON string for FCM
# FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional LLM for richer assistive drafts. Without it, SOAP/symptom helper use templates.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Same Paystack keys as Bytz Go (pk_test_/sk_test_ or pk_live_/sk_live_ pair)
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYSTACK_SECRET_KEY=sk_test_your_key_here
# PAYSTACK_CALLBACK_URL=https://your-api.onrender.com
# APP_URL=https://your-api.onrender.com
